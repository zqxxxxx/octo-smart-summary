ARG ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

FROM golang:1.25-alpine AS builder
ARG ALPINE_MIRROR

ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}

# Install build dependencies for CGO
RUN sed -i "s#https://dl-cdn.alpinelinux.org/alpine#${ALPINE_MIRROR}#g" /etc/apk/repositories \
    && apk add --no-cache gcc g++ musl-dev curl

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Download prebuilt libtokenizers.a (musl version for Alpine)
# Detect architecture and download appropriate version
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        LIBTOK_ARCH="amd64"; \
        LIBTOK_SHA256="8043d2f258b2f4d84d2bef6868e2b971a37b9979afb9000965b38bce706d52d4"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        LIBTOK_ARCH="arm64"; \
        LIBTOK_SHA256="8c64d719b7b35d824b7e2ff7fc8c2c49eca806169c11ea71a9c494e909a76399"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    LIBTOK_ARCHIVE="/tmp/libtokenizers.linux-musl-${LIBTOK_ARCH}.tar.gz" && \
    curl -fL --retry 8 --retry-all-errors --retry-delay 2 \
        --connect-timeout 30 --max-time 600 --continue-at - \
        -o "$LIBTOK_ARCHIVE" \
        "https://github.com/daulet/tokenizers/releases/download/v1.27.0/libtokenizers.linux-musl-${LIBTOK_ARCH}.tar.gz" && \
    echo "$LIBTOK_SHA256  $LIBTOK_ARCHIVE" | sha256sum -c - && \
    tar -xzf "$LIBTOK_ARCHIVE" && \
    mv libtokenizers.a /usr/local/lib/

# Build with CGO enabled for exact tokenizer (Qwen/DeepSeek)
ENV CGO_ENABLED=1
ENV CGO_LDFLAGS="-L/usr/local/lib"
RUN go build -o /bin/summary-worker ./cmd/summary-worker

# Download tokenizer models for exact token counting
FROM alpine:3.19 AS tokenizer-models
ARG ALPINE_MIRROR
RUN sed -i "s#https://dl-cdn.alpinelinux.org/alpine#${ALPINE_MIRROR}#g" /etc/apk/repositories \
    && apk add --no-cache curl bash
WORKDIR /models
COPY scripts/download_tokenizer_models.sh /scripts/
ENV TOKENIZER_MODELS_DIR=/models
RUN /scripts/download_tokenizer_models.sh

FROM alpine:3.19
ARG ALPINE_MIRROR
ENV TZ=Asia/Shanghai
RUN sed -i "s#https://dl-cdn.alpinelinux.org/alpine#${ALPINE_MIRROR}#g" /etc/apk/repositories \
    && apk add --no-cache ca-certificates tzdata libstdc++ libgcc \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone
COPY --from=builder /bin/summary-worker /bin/summary-worker
COPY --from=tokenizer-models /models /app/tokenizer-models
ENV TOKENIZER_MODELS_DIR=/app/tokenizer-models
EXPOSE 8082
ENTRYPOINT ["/bin/summary-worker"]
